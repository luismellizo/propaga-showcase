# =============================================================================
# PROPAGA - Variables de Entorno para Producción
# =============================================================================
# IMPORTANTE: Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Django - Configuración Principal
# -----------------------------------------------------------------------------
# Clave secreta de Django (genera una nueva para producción)
# Puedes generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-muy-larga-y-segura-aqui

# Modo debug (SIEMPRE False en producción)
DEBUG=False

# -----------------------------------------------------------------------------
# Base de Datos PostgreSQL
# -----------------------------------------------------------------------------
DB_NAME=propaga_db
DB_USER=propaga_user
DB_PASSWORD=tu-password-seguro-aqui
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------------------------------------
# APIs Externas
# -----------------------------------------------------------------------------
# Google Gemini API (para generación de contenido, modelo gemini-3.1-flash-lite)
GEMINI_API_KEY=tu-api-key-de-gemini

# Groq API (para transcripción de audio con Whisper)
GROQ_API_KEY=gsk_tu-api-key-de-groq

# Token de Google Search Console (solo el valor del atributo content del meta tag).
# Necesario para la verificación de marca de la pantalla de consentimiento OAuth.
GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# OAuth de redes sociales (se cargan a la DB con: manage.py seed_social_apps)
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth 2.0
# Redirect URI a registrar: https://<dominio>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers → Configuración → Básica (Facebook + Instagram)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# X (Twitter) — OJO: son las "Consumer Keys" (API Key 25 chars / Secret 50),
# NO el "OAuth 2.0 Client ID and Client Secret".
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# TikTok for Developers (app en borrador — todavía sin SocialApp)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Configuración de Celery (normalmente no necesitas cambiar esto)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Límites de tiempo por tarea, en segundos (soft lanza excepción, hard mata el proceso)
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800

# -----------------------------------------------------------------------------
# Dominios Permitidos (para ALLOWED_HOSTS y CSRF)
# -----------------------------------------------------------------------------
# Separa múltiples dominios con comas
ALLOWED_HOSTS=propaga.lat,www.propaga.lat
CSRF_TRUSTED_ORIGINS=https://propaga.lat,https://www.propaga.lat
